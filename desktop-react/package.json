{
  "name": "@loom/desktop-react",
  "version": "0.1.23",
  "private": true,
  "type": "module",
  "main": "dist-electron/entry.js",
  "scripts": {
    "clean:electron": "node -e \"const fs=require('node:fs'); for (const dir of ['dist-electron','dist']) fs.rmSync(dir,{recursive:true,force:true})\"",
    "prepare:stickers": "node scripts/prepare-chat-stickers.mjs",
    "setup:python": "node scripts/setup-python.mjs",
    "setup:ufo": "node scripts/setup-ufo.mjs",
    "ufo:preflight": "node scripts/ufo-preflight.mjs",
    "browser:cdp": "node scripts/start-browser-cdp.mjs --no-run",
    "browser:cdp:dry-run": "node scripts/start-browser-cdp.mjs --dry-run",
    "dev:browser": "node scripts/start-browser-cdp.mjs dev",
    "start:browser": "node scripts/start-browser-cdp.mjs start",
    "browser:extension": "node scripts/start-browser-extension.mjs --no-run",
    "dev:extension": "node scripts/start-browser-extension.mjs dev",
    "start:extension": "node scripts/start-browser-extension.mjs start",
    "dev:ready": "node scripts/dev-ready-ufo.mjs",
    "dev:ready:auto": "node scripts/dev-ready.mjs --mode=auto",
    "test:ufo-scripts": "node --test scripts/tests/*.test.mjs",
    "test:streaming": "node --test scripts/tests/streaming-text.test.mjs",
    "test:profile": "node --test scripts/tests/profile-insights.test.mjs",
    "test:electron": "npm run build:electron && node --experimental-test-module-mocks --test electron/tests/*.test.mjs",
    "test:host-process": "npm run build:electron && node scripts/host-process-smoke.mjs",
    "check:live-account": "npm run build:electron && node --experimental-test-module-mocks --test scripts/check-live-account.mjs",
    "dev:ready:ufo": "node scripts/dev-ready-ufo.mjs",
    "predev": "npm run prepare:stickers",
    "prebuild:renderer": "npm run prepare:stickers",
    "build:renderer": "tsc --noEmit && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:runtime:win": "node scripts/build-windows-runtime.mjs",
    "package:host-runtime": "node scripts/package-host-runtime.mjs",
    "dev": "npm run clean:electron && npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on http://127.0.0.1:5173 && electron dist-electron/entry.js --dev-url=http://127.0.0.1:5173\"",
    "build": "npm run clean:electron && npm run build:electron && npm run build:renderer",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "npm run build && electron dist-electron/entry.js",
    "package:win:dir": "npm run build && npm run build:runtime:win && electron-builder --win --x64 --dir",
    "package:win": "npm run build && npm run build:runtime:win && electron-builder --win nsis --x64 --publish never",
    "package:win:publish": "npm run build && npm run build:runtime:win && electron-builder --win nsis --x64 --publish always",
    "build:web": "npm run build:renderer"
  },
  "dependencies": {
    "electron-updater": "^6.8.10",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@microsoft/mxc-sdk": "0.8.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.1",
    "electron": "^36.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "wait-on": "^8.0.4",
    "@types/ws": "^8.18.1"
  },
  "build": {
    "appId": "com.loom.agent",
    "productName": "Loom",
    "protocols": [
      {
        "name": "Loom",
        "schemes": [
          "loom"
        ]
      }
    ],
    "asar": true,
    "electronUpdaterCompatibility": ">=2.16",
    "publish": [
      {
        "provider": "github",
        "owner": "yuchenm1303-png",
        "repo": "Loom",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "loom-icon.png"
      },
      {
        "from": "runtime-dist/python",
        "to": "."
      },
      {
        "from": "node_modules/@microsoft/mxc-sdk/bin/x64/wxc-exec.exe",
        "to": "wxc-exec.exe"
      },
      {
        "from": "../extensions/browser-current-tab",
        "to": "browser-current-tab"
      }
    ],
    "artifactName": "Loom-Setup-x64.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.png"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Loom"
    }
  }
}
