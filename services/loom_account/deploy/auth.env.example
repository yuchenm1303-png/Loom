# Loom Account authentication providers. Copy to .env.auth on the server.
# Keep this file server-side only. Never ship these secrets in Desktop/Web builds.

# Canonical public URLs used for OAuth callbacks and safe return validation.
LOOM_ACCOUNT_PUBLIC_BASE_URL=https://account.smirel.com/v1
LOOM_WEB_ORIGIN=https://loom.smirel.com

# Email verification / password reset. Choose one provider.
# Option A: Resend
LOOM_EMAIL_PROVIDER=resend
LOOM_EMAIL_FROM=Loom <account@smirel.com>
LOOM_RESEND_API_KEY=

# Option B: SMTP (set LOOM_EMAIL_PROVIDER=smtp instead)
# LOOM_SMTP_HOST=smtp.example.com
# LOOM_SMTP_PORT=587
# LOOM_SMTP_USERNAME=
# LOOM_SMTP_PASSWORD=
# LOOM_SMTP_TLS=1

# Google OAuth. Redirect URI:
# https://account.smirel.com/v1/auth/oauth/google/callback
LOOM_GOOGLE_CLIENT_ID=
LOOM_GOOGLE_CLIENT_SECRET=

# GitHub OAuth App. Callback URL:
# https://account.smirel.com/v1/auth/oauth/github/callback
LOOM_GITHUB_CLIENT_ID=
LOOM_GITHUB_CLIENT_SECRET=

# Keep enabled while older Loom builds still exist. Set to 0 after verified
# registration is available everywhere to require the new registration flow.
LOOM_ALLOW_LEGACY_REGISTER=1
