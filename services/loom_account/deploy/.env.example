# Copy to .env on the server and keep the real file private (chmod 600).
# Do not enable verification until SMTP delivery has been tested.
LOOM_ACCOUNT_REQUIRE_EMAIL_VERIFICATION=0
LOOM_ACCOUNT_VERIFICATION_TTL=600
LOOM_ACCOUNT_VERIFICATION_RESEND_COOLDOWN=60
LOOM_ACCOUNT_VERIFICATION_MAX_ATTEMPTS=6

# SMTP examples:
# STARTTLS: port 587 + starttls
# Implicit TLS: port 465 + implicit
LOOM_ACCOUNT_SMTP_HOST=
LOOM_ACCOUNT_SMTP_PORT=587
LOOM_ACCOUNT_SMTP_USERNAME=
LOOM_ACCOUNT_SMTP_PASSWORD=
LOOM_ACCOUNT_SMTP_FROM=
LOOM_ACCOUNT_SMTP_FROM_NAME=Loom
LOOM_ACCOUNT_SMTP_TLS_MODE=starttls
