{
  "manifest_version": 3,
  "name": "loom",
  "version": "0.1.17",
  "description": "Lets Loom inspect and control the current Chrome/Edge tab through a local loopback bridge.",
  "permissions": ["tabs", "tabGroups", "activeTab", "scripting", "storage", "cookies", "downloads", "alarms", "debugger"],
  "host_permissions": ["http://127.0.0.1/*", "http://[::1]/*", "http://*/*", "https://*/*", "<all_urls>"],
  "background": {
    "service_worker": "bridge-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["browser-hud.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Loom Browser Bridge"
  },
  "options_page": "options.html"
}
